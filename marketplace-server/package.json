{
  "name": "nnbot-marketplace",
  "version": "0.1.0",
  "description": "Plugin marketplace server for NNBot",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
